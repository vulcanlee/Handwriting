@implements IAsyncDisposable
@inject IJSRuntime JS
@if (_session is not null) {
<section class="lesson"><div class="lesson-heading"><div><p class="eyebrow">現在練習</p><h2><span>@Symbol.Glyph</span> 第 @Math.Min(_session.CurrentStroke + 1, Symbol.Strokes.Count) 筆，共 @Symbol.Strokes.Count 筆</h2></div></div>
@if (!_started) { <div class="start-gate"><span class="start-glyph">@Symbol.Glyph</span><h3>準備好小手了嗎？</h3><p>按下開始，先聽發音，再看筆順。</p><button class="primary-button big" @onclick="StartPractice">▶ 開始練習</button></div> }
else if (_session.IsComplete) { <div class="celebration"><div class="confetti">★ <span>●</span> ★</div><span class="complete-glyph">@Symbol.Glyph</span><h3>太棒了，寫完了！</h3><p>每一筆都認真完成，給小手拍拍手。</p><div class="completion-actions"><button class="secondary-button" @onclick="OnAgain">再寫一次</button><button class="primary-button" @onclick="OnNext">下一個 →</button></div></div> }
else { <div class="practice-cards">
<article class="practice-card demo-card"><h3><span>1</span>先看我怎麼寫</h3><div class="svg-wrap"><svg viewBox="0 0 100 100" class="demo-svg" aria-label="筆順示範"><defs><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="4" markerHeight="4" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#d87b2f" /></marker></defs>@if(Symbol.Category is not ("upper" or "lower")){<path class="guide-grid" d="M50 7V93M7 50H93" />}@if(Symbol.Category is "upper" or "lower"){<path class="baseline-grid" d="M7 20H93M7 40H93M7 80H93M7 94H93"/>}@for (var i=0;i<Symbol.Strokes.Count;i++) { var s=Symbol.Strokes[i]; <path d="@s.Path" marker-end="@(i == _session.CurrentStroke ? "url(#arrow)" : null)" class="demo-stroke @(i < _session.CurrentStroke ? "done" : i == _session.CurrentStroke ? "current" : "future")" /> @if(s.Points.Count>0){<circle cx="@s.Points[0].X" cy="@s.Points[0].Y" r="2.3" class="start-dot @(i == _session.CurrentStroke ? "current" : "")"/><g><text x="@(s.Points[0].X+4)" y="@(s.Points[0].Y-3)" class="stroke-number"><tspan>@(i+1)</tspan></text></g>} }</svg></div><p class="instruction">@CurrentStroke.Instruction</p><div class="card-actions"><button class="secondary-button" disabled="@(_cueBusy || Suspended)" @onclick="ReplayStroke">↻ 再看一次</button><button class="round-button" aria-label="聽符號讀音" disabled="@(_cueBusy || Suspended)" @onclick="PlayPronunciation">🔊</button></div></article>
<article class="practice-card draw-card"><h3><span>2</span>換你的小手試試</h3><div class="drawing-wrap @(_submitting || _cueBusy || Suspended ? "locked" : "")"><svg viewBox="0 0 100 100" class="trace-svg">@if(Symbol.Category is not ("upper" or "lower")){<path class="guide-grid" d="M50 7V93M7 50H93" />}@if(Symbol.Category is "upper" or "lower"){<path class="baseline-grid" d="M7 20H93M7 40H93M7 80H93M7 94H93"/>}@for(var i=0;i<Symbol.Strokes.Count;i++){<path d="@Symbol.Strokes[i].Path" class="trace-stroke @(i < _session.CurrentStroke ? "accepted" : i == _session.CurrentStroke ? "target" : "ghost")"/>}<circle cx="@CurrentStroke.Points[0].X" cy="@CurrentStroke.Points[0].Y" r="2.3" class="start-dot current" /></svg><canvas id="practice-canvas" aria-label="書寫區"></canvas>@if(_submitting){<span class="checking">正在看看…</span>}</div><p class="feedback @(_feedbackGood ? "good" : "")" aria-live="polite">@_feedback</p><div class="card-actions"><button class="secondary-button" @onclick="ClearInk">清除這一筆</button><span class="stroke-progress">@(_session.CurrentStroke+1) / @Symbol.Strokes.Count</span></div></article>
</div> }</section>
}
