@page "/"
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@using Handwriting.Client.Components

<PageTitle>小手寫寫 · 動物探險</PageTitle>
<header class="site-header"><a class="brand" href="#top"><span class="brand-mark">✎</span>小手寫寫</a><div class="header-actions"><button class="icon-button" @onclick="ToggleMute" aria-label="切換聲音">@(_state.Muted ? "🔇" : "🔊")</button><span class="status-pill">@_offlineText</span></div></header>
<main id="top" class="app-shell">
@if (!_loaded) { <section class="loading-card"><p>正在準備探險背包…</p></section> }
else {
    @if (_notice is not null) { <div class="notice" role="status">@_notice<button aria-label="關閉訊息" @onclick="() => _notice = null">×</button></div> }
    @if (!_writer) { <section class="adventure-card"><h1>先讓另一個小手完成練習</h1><p>關閉其他練習分頁後，重新載入即可接續。</p></section> }
    else {
        <section class="profile-bar" aria-label="孩子的探險背包">
        @if (Child is not null) {
            <img src="@($"images/animals/{Child.Avatar}.svg")" alt="" width="56" height="56" />
            <label>今天的探險家<select aria-label="切換孩子" value="@_state.ActiveChildId" @onchange="SwitchChild">@foreach (var c in _state.Children) { <option value="@c.Id">@c.Name</option> }</select></label>
            <button class="secondary-button" @onclick="() => EditChild(false)">編輯</button>
            <button class="secondary-button" @onclick="() => EditChild(true)">＋ 新增孩子</button>
        }
        </section>
        @if (_editing) {
            <section class="adventure-card profile-editor"><p class="eyebrow">一人一個探險背包</p><h1>@(_newChild ? "你叫什麼名字？" : "編輯探險家")</h1>
            <label>暱稱<input aria-label="暱稱" maxlength="20" @bind="_name" /></label>
            <fieldset><legend>選一位動物夥伴</legend><div class="avatar-options">@foreach (var c in BadgeCatalog.Categories.Take(4)) { <button class="avatar-button @(_avatar == c.Key ? "chosen" : "")" aria-pressed="@(_avatar == c.Key)" aria-label="@c.Animal" @onclick="() => _avatar = c.Key"><img src="@($"images/animals/{c.Key}.svg")" alt="" /><span>@c.Animal</span></button> }</div></fieldset>
            @if (_state.LegacyProgress is not null && _state.Children.Count == 0) { <p>原本的練習紀錄會放進這位孩子的背包，並補上已達標的徽章。</p> }
            @if (_profileError is not null) { <p role="alert">@_profileError</p> }
            <button class="primary-button" @onclick="SaveChild">保存探險家</button>
            @if (Child is not null) { <button class="secondary-button" @onclick="() => _editing = false">取消</button> }
            </section>
        }
        else if (Child is not null && _symbols.Count > 0) {
            <nav class="adventure-nav" aria-label="主要功能"><button class="@(_page == "practice" ? "active" : "")" @onclick='() => Navigate("practice")'>✎ 自由練習</button><button class="@(_page == "challenge" ? "active" : "")" @onclick='() => Navigate("challenge")'>⚑ 探險闖關</button><button class="@(_page == "badges" ? "active" : "")" @onclick='() => Navigate("badges")'>★ 我的徽章 <small>@Child.Awards.Count / 88</small></button></nav>
            @if (_earned.Count > 0 && (_symbol is null || _questionCredited || _run is { Status: not "playing" })) { <aside class="earned-banner" role="status"><div><strong>新徽章入袋！每一筆努力都有收穫。</strong><p>這次解鎖 @_earned.Count 枚徽章</p></div><div class="earned-icons">@foreach (var b in _earned.Take(4)) { <img src="@b.Image" alt="@b.Name" /> }</div><button class="secondary-button" aria-label="收起新徽章" @onclick="() => _earned = []">收進背包</button></aside> }
            @if (_page == "badges") {
                <BadgeWall Child="Child" Badges="_badges" OnPlay="PlayBadge" OnClose="StopBadgeAudio" />
            }
            else {
                @if (_page == "practice") {
                    <section class="welcome"><div><p class="eyebrow">和動物夥伴，每天進步一點點</p><h1>今天，想寫哪一個？</h1></div><div class="overall"><strong>@Child.Progress.Count(x => x.Value.Completed && _symbols.Any(s => s.Id == x.Key))</strong><span>／ @_symbols.Count 已完成</span></div></section>
                    <section class="picker-card"><div class="category-tabs" role="tablist" aria-label="練習分類">@foreach (var c in BadgeCatalog.Categories.Take(4)) { <button role="tab" aria-selected="@(_category == c.Key)" class="category-tab @(_category == c.Key ? "active" : "")" @onclick="() => SelectCategory(c.Key)"><span>@c.Animal</span><strong>@c.Label</strong></button> }</div><div class="symbol-grid">@foreach (var s in _symbols.Where(s => s.Category == _category)) { <button class="symbol-tile @(_symbol == s ? "selected" : "")" aria-label="@($"練習 {s.Glyph}")" @onclick="() => SelectSymbol(s)"><span>@s.Glyph</span>@if (Child.Progress.TryGetValue(s.Id, out var p) && p.Completed) { <i>✓</i> }</button> }</div></section>
                    <label class="mode-select">判定範圍<select value="@(_state.Relaxed ? "relaxed" : "standard")" @onchange="ChangeMode"><option value="relaxed">寬鬆</option><option value="standard">一般</option></select></label>
                }
                else if (_run is null) {
                    <section class="adventure-hero"><img src="images/animals/mixed.svg" alt="動物探險隊" /><div><p class="eyebrow">準備出發，收集新的探險紀念章</p><h1>今天想去哪裡探險？</h1><p>先選夥伴和題目，沿著線慢慢寫。不限時也有徽章喔！</p></div></section>
                    <section class="adventure-card challenge-settings"><fieldset><legend>1. 選擇題型，可以多選</legend><div class="avatar-options">@foreach (var c in BadgeCatalog.Categories.Take(4)) { <button class="avatar-button @(_selectedCategories.Contains(c.Key) ? "chosen" : "")" aria-pressed="@_selectedCategories.Contains(c.Key)" @onclick="() => ToggleCategory(c.Key)"><img src="@($"images/animals/{c.Key}.svg")" alt="" /><strong>@c.Label</strong></button> }</div></fieldset>
                    <div class="setting-row"><label>2. 這次挑戰幾題？<select aria-label="題目數量" @bind="_count"><option value="5">5 題 · 小小探險</option><option value="10">10 題 · 森林旅行</option><option value="20">20 題 · 大冒險</option></select></label><label>3. 挑戰方式<select aria-label="挑戰方式" value="@(_timed ? "timed" : "adventure")" @onchange="ChangeChallengeMode"><option value="adventure">不限時冒險</option><option value="timed">限時挑戰</option></select></label><label>判定範圍<select value="@(_state.Relaxed ? "relaxed" : "standard")" @onchange="ChangeMode"><option value="relaxed">寬鬆</option><option value="standard">一般</option></select></label></div>
                    <p>每題都有描線與示範。@(_timed ? "作答時間依抽到的筆畫計算，可以暫停休息。" : "不用趕時間，寫完所有題目就能通關。")</p>
                    <button class="primary-button big" disabled="@(_selectedCategories.Count == 0)" @onclick="StartChallenge">開始探險</button></section>
                }
                else if (_run.Status != "playing") {
                    <section class="celebration adventure-result"><img class="result-animal" src="@($"images/animals/{_run.Category}.svg")" alt="探險夥伴" /><h1>@ResultTitle</h1><p>這次完整寫完了 <strong>@_run.Completed / @_run.Questions.Count 題</strong>。</p><p>@(_run.Status == "passed" ? "通關次數已累積，新的目標正等著你！" : "已寫完的符號都算學習成果，下次再一起出發。")</p><div class="completion-actions"><button class="primary-button" @onclick="StartChallenge">再次挑戰</button><button class="secondary-button" @onclick="() => _run = null">重新選擇</button><button class="secondary-button" @onclick='() => Navigate("badges")'>看看徽章</button></div></section>
                }
                @if (_run is { Status: "playing" }) { <section class="challenge-status"><strong>第 @(_run.Completed + 1) / @_run.Questions.Count 題</strong><span>@(_run.Timed ? $"剩餘 {ClockText}" : "不限時，慢慢寫")</span><span>@(_run.Paused ? "已暫停 · 不計時" : _boardBusy ? "正在示範 · 不計時" : "小手作答中")</span><button class="secondary-button" @onclick="Pause">暫停</button><button class="secondary-button" @onclick="Abort">結束探險</button></section> }
                @if (_symbol is not null && (_page == "practice" || _run is { Status: "playing" })) {
                    var paused = _freePaused || _run?.Paused == true;
                    <div class="board-shell">
                        <div class="@(paused ? "paused-board" : "")" inert="@paused" aria-hidden="@paused">
                        <PracticeBoard Symbol="_symbol" RunKey="@BoardKey" AutoStart="@(_run is not null)" Relaxed="@(_run?.Relaxed ?? _state.Relaxed)" Muted="_state.Muted" Suspended="paused" OnStarted="Started" OnCompleted="Completed" BeforeSubmit="BeforeSubmit" OnBusy="Busy" OnNotice="Notice" OnAgain="Again" OnNext="Next" />
                        </div>
                        @if (paused) { <section class="pause-cover" role="region" aria-label="已暫停"><span>☁</span><h2>小手休息一下</h2><p>題目和時間都在這裡等你。</p><button class="primary-button" @onclick="Resume">繼續探險</button></section> }
                    </div>
                }
            }
        }
    }
}
</main>
<footer><span>陪孩子慢慢寫、開心學</span><a href="credits.html">素材與授權</a><span>v0.1.2</span><button @onclick="RetryOffline">檢查離線教材</button></footer>
