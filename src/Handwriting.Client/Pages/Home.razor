@page "/"
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>小手寫寫</PageTitle>
<header class="site-header"><a class="brand" href="#top"><span class="brand-mark">✎</span>小手寫寫</a><div class="header-actions"><button class="icon-button" @onclick="ToggleMute" aria-label="切換聲音">@(_muted ? "🔇" : "🔊")</button><span class="status-pill @(_online ? "online" : "offline")"><i></i>@_offlineText</span></div></header>
<main id="top" class="app-shell">
@if (!_loaded) { <section class="loading-card"><span class="pencil-loader">✎</span><p>正在準備練習本…</p></section> }
else {
<section class="welcome"><div><p class="eyebrow">每天一點點，手手更有力</p><h1>今天，想寫哪一個？</h1></div><div class="overall"><strong>@CompletedCount</strong><span>／ @_symbols.Count 已完成</span></div></section>
@if (_notice is not null) { <div class="notice" role="status"><span>💡</span>@_notice <button @onclick="() => _notice = null">×</button></div> }
<section class="picker-card"><div class="category-tabs" role="tablist" aria-label="練習分類">@foreach (var c in Categories) { <button role="tab" aria-selected="@(_category == c.Key)" class="category-tab @(_category == c.Key ? "active" : "")" @onclick="() => SelectCategory(c.Key)"><strong>@c.Icon</strong><span>@c.Label</span></button> }</div><button class="grid-toggle" @onclick="() => _gridOpen = !_gridOpen" aria-expanded="@_gridOpen"><span>選一個來練習</span><span>@(_gridOpen ? "收起 ↑" : "展開 ↓")</span></button>
@if (_gridOpen) { <div class="symbol-grid">@foreach (var symbol in CategorySymbols) { <button class="symbol-tile @(_selected?.Id == symbol.Id ? "selected" : "")" @onclick="() => SelectSymbol(symbol)" aria-label="練習 @symbol.Glyph"><span>@symbol.Glyph</span>@if (ProgressFor(symbol).Completed) { <i>✓</i> }</button> }</div> }
</section>
@if (_selected is not null && _session is not null) {
<section class="lesson"><div class="lesson-heading"><div><p class="eyebrow">現在練習</p><h2><span>@_selected.Glyph</span> 第 @Math.Min(_session.CurrentStroke + 1, _selected.Strokes.Count) 筆，共 @_selected.Strokes.Count 筆</h2></div><label class="mode-select">判定範圍<select value="@(_relaxed ? "relaxed" : "standard")" @onchange="ChangeMode"><option value="relaxed">寬鬆</option><option value="standard">一般</option></select></label></div>
@if (!_started) { <div class="start-gate"><span class="start-glyph">@_selected.Glyph</span><h3>準備好小手了嗎？</h3><p>按下開始，先聽發音，再看筆順。</p><button class="primary-button big" @onclick="StartPractice">▶ 開始練習</button></div> }
else if (_session.IsComplete) { <div class="celebration"><div class="confetti">★ <span>●</span> ★</div><span class="complete-glyph">@_selected.Glyph</span><h3>太棒了，寫完了！</h3><p>每一筆都認真完成，給小手拍拍手。</p><div class="completion-actions"><button class="secondary-button" @onclick="PracticeAgain">再寫一次</button><button class="primary-button" @onclick="NextSymbol">下一個 →</button></div></div> }
else { <div class="practice-cards">
<article class="practice-card demo-card"><h3><span>1</span>先看我怎麼寫</h3><div class="svg-wrap"><svg viewBox="0 0 100 100" class="demo-svg" aria-label="筆順示範"><defs><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="4" markerHeight="4" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#d87b2f" /></marker></defs>@if(_category is not ("upper" or "lower")){<path class="guide-grid" d="M50 7V93M7 50H93" />}@if(_category is "upper" or "lower"){<path class="baseline-grid" d="M7 20H93M7 40H93M7 80H93M7 94H93"/>}@for (var i=0;i<_selected.Strokes.Count;i++) { var s=_selected.Strokes[i]; <path d="@s.Path" marker-end="@(i == _session.CurrentStroke ? "url(#arrow)" : null)" class="demo-stroke @(i < _session.CurrentStroke ? "done" : i == _session.CurrentStroke ? "current" : "future")" /> @if(s.Points.Count>0){<circle cx="@s.Points[0].X" cy="@s.Points[0].Y" r="2.3" class="start-dot @(i == _session.CurrentStroke ? "current" : "")"/><g><text x="@(s.Points[0].X+4)" y="@(s.Points[0].Y-3)" class="stroke-number"><tspan>@(i+1)</tspan></text></g>} }</svg></div><p class="instruction">@CurrentStroke.Instruction</p><div class="card-actions"><button class="secondary-button" @onclick="ReplayStroke">↻ 再看一次</button><button class="round-button" aria-label="聽符號讀音" @onclick="PlayPronunciation">🔊</button></div></article>
<article class="practice-card draw-card"><h3><span>2</span>換你的小手試試</h3><div class="drawing-wrap @(_submitting ? "locked" : "")"><svg viewBox="0 0 100 100" class="trace-svg">@if(_category is not ("upper" or "lower")){<path class="guide-grid" d="M50 7V93M7 50H93" />}@if(_category is "upper" or "lower"){<path class="baseline-grid" d="M7 20H93M7 40H93M7 80H93M7 94H93"/>}@for(var i=0;i<_selected.Strokes.Count;i++){<path d="@_selected.Strokes[i].Path" class="trace-stroke @(i < _session.CurrentStroke ? "accepted" : i == _session.CurrentStroke ? "target" : "ghost")"/>}<circle cx="@CurrentStroke.Points[0].X" cy="@CurrentStroke.Points[0].Y" r="2.3" class="start-dot current" /></svg><canvas id="practice-canvas" aria-label="書寫區"></canvas>@if(_submitting){<span class="checking">正在看看…</span>}</div><p class="feedback @(_feedbackGood ? "good" : "")" aria-live="polite">@_feedback</p><div class="card-actions"><button class="secondary-button" @onclick="ClearInk">清除這一筆</button><span class="stroke-progress">@(_session.CurrentStroke+1) / @_selected.Strokes.Count</span></div></article>
</div> }</section> }
}
</main>
<footer><span>陪孩子慢慢寫、開心學</span><a href="credits.html">素材與授權</a><span>v0.1.1</span><button @onclick="RetryOffline">檢查離線教材</button></footer>
